# Temporary #385 original/C parity gate. Removed only after the complete green CI gate.
if(NOT CHECK MATCHES "^(runtime_strings|string_method_errors)$" OR NOT EXISTS "${PYTHON}")
  message(FATAL_ERROR "Original strings parity needs an explicit Python and check")
endif()
string(RANDOM LENGTH 24 ALPHABET 0123456789abcdef nonce)
set(work "${BUILD}/native-original-${CHECK}/scenario-${nonce}")
set(original "${work}/original")
set(converted "${work}/converted")
file(MAKE_DIRECTORY "${original}" "${converted}")
set(original_flags "")
set(converted_flags "")
if(SANITIZE)
  set(original_flags -fsanitize=undefined -fno-sanitize-recover=all)
  set(converted_flags -- ${original_flags})
endif()
execute_process(COMMAND "${PYTHON}" "${REPOSITORY}/test/src/native/checks/${CHECK}.py"
  "${GOAT}" "${original}" ${original_flags}
  WORKING_DIRECTORY "${REPOSITORY}" TIMEOUT 300 RESULT_VARIABLE original_status
  OUTPUT_FILE "${work}/original.stdout" ERROR_FILE "${work}/original.stderr")
if(NOT original_status STREQUAL "0")
  file(READ "${work}/original.stderr" error)
  message(FATAL_ERROR "Original ${CHECK} failed (${original_status}); ${work}\n${error}")
endif()
execute_process(COMMAND "${RUNNER}" all "${GOAT}" "${REPOSITORY}" "${converted}"
  "${REPOSITORY}/test/data" --keep-work ${converted_flags}
  WORKING_DIRECTORY "${REPOSITORY}" TIMEOUT 330 RESULT_VARIABLE converted_status
  OUTPUT_FILE "${work}/converted.stdout" ERROR_FILE "${work}/converted.stderr")
if(NOT converted_status STREQUAL "0")
  file(READ "${work}/converted.stderr" error)
  file(READ "${work}/converted.stdout" output)
  message(FATAL_ERROR "C ${CHECK} failed (${converted_status}); ${work}\n${output}\n${error}")
endif()
file(GLOB converted_work LIST_DIRECTORIES true "${converted}/scenario-*")
list(LENGTH converted_work converted_count)
if(NOT converted_count EQUAL 1)
  message(FATAL_ERROR "Expected one C aggregate workspace; found ${converted_count}: ${work}")
endif()
list(GET converted_work 0 converted)
# file(READ) text mode normalizes CRLF even on Linux. HEX preserves all bytes.
function(equal_files first second)
  file(READ "${first}" a HEX)
  file(READ "${second}" b HEX)
  if(NOT a STREQUAL b)
    message(FATAL_ERROR "Original/C bytes differ: ${first} / ${second}; ${work}")
  endif()
endfunction()
function(frozen_file actual fixture)
  file(READ "${actual}" a HEX)
  file(READ "${fixture}" b HEX)
  if(WIN32)
    set(expected "")
    string(LENGTH "${b}" n)
    if(n GREATER 0)
      math(EXPR last "${n} - 2")
      foreach(offset RANGE 0 ${last} 2)
        string(SUBSTRING "${b}" ${offset} 2 byte)
        if(byte STREQUAL "0a")
          string(APPEND expected "0d")
        endif()
        string(APPEND expected "${byte}")
      endforeach()
    endif()
    set(b "${expected}")
  endif()
  if(NOT a STREQUAL b)
    message(FATAL_ERROR "Generated/frozen bytes differ: ${actual} / ${fixture}; ${work}")
  endif()
endfunction()
if(CHECK STREQUAL "runtime_strings")
  set(fixture_root "${REPOSITORY}/test/data/native-runtime-strings")
  foreach(name IN ITEMS strings.c strings.goat invalid-0.goat invalid-1.goat invalid-2.goat invalid-3.goat invalid-4.goat invalid-5.goat invalid-6.goat)
    if(name MATCHES "\\.c$")
      set(fixture "${name}.txt")
    else()
      set(fixture "${name}")
    endif()
    frozen_file("${original}/${name}" "${fixture_root}/${fixture}")
    equal_files("${original}/${name}" "${converted}/${name}")
  endforeach()
  if(NOT SANITIZE)
    frozen_file("${original}/automatic.c" "${fixture_root}/automatic.c.txt")
    equal_files("${original}/automatic.c" "${converted}/automatic.c")
  endif()
  foreach(name IN ITEMS native.txt vm.txt)
    equal_files("${original}/${name}" "${converted}/${name}")
  endforeach()
else()
  foreach(name IN ITEMS bounds types identity)
    frozen_file("${converted}/${name}/program.goat.input" "${REPOSITORY}/test/data/native-string-methods/${name}.goat")
    foreach(label IN ITEMS vm compile native saved)
      foreach(stream IN ITEMS stdout stderr)
        equal_files("${original}/${name}/${label}.${stream}" "${converted}/${name}/${label}.${stream}")
      endforeach()
    endforeach()
    foreach(label IN ITEMS native saved)
      equal_files("${original}/${name}/${label}.report" "${converted}/${name}/${label}.report")
    endforeach()
  endforeach()
endif()
message(STATUS "Original/C ${CHECK} parity and frozen bytes passed; retained ${work}")
