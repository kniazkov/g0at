# Exact output parity across source/saved programs and VM/native execution.
file(MAKE_DIRECTORY "${WORK}")
foreach(case basic self_unicode inheritance errors)
  set(source "${DATA}/string_builder_${case}/program.goat")
  file(READ "${DATA}/string_builder_${case}/expected_output.txt" expected)
  foreach(optimization none all)
    set(input "${WORK}/${case}-${optimization}.goat")
    configure_file("${source}" "${input}" COPYONLY)
    set(compile_mode off)
    if(optimization STREQUAL all)
      set(compile_mode required)
    endif()
    execute_process(COMMAND "${GOAT}" --optimize ${optimization} --native ${compile_mode} --compile "${input}"
      RESULT_VARIABLE status ERROR_VARIABLE error)
    if(NOT status EQUAL 0)
      message(FATAL_ERROR "Compile ${case}/${optimization}: ${error}")
    endif()
    string(REPLACE ".goat" ".gbin" binary "${input}")
    file(SHA256 "${binary}" before)
    foreach(mode off auto required)
      if(NOT mode STREQUAL off AND optimization STREQUAL none)
        continue()
      endif()
      foreach(program "${input}" "${binary}")
        set(command "${GOAT}")
        if(program STREQUAL binary)
          set(command "${CMAKE_COMMAND}" -E env "CC=goat-missing-compiler-for-test" "${GOAT}")
        endif()
        set(report_options)
        if(mode STREQUAL required)
          set(report_options --save-native "${WORK}/native.report")
        endif()
        execute_process(COMMAND ${command} --optimize ${optimization} --native ${mode} ${report_options} "${program}"
          RESULT_VARIABLE status OUTPUT_VARIABLE actual ERROR_VARIABLE error TIMEOUT 60)
        string(REPLACE "\r\n" "\n" actual "${actual}")
        if(NOT status EQUAL 0 OR NOT actual STREQUAL expected)
          message(FATAL_ERROR "${case}/${optimization}/${mode}/${program}: status=${status}\n${error}\nExpected:\n${expected}\nActual:\n${actual}")
        endif()
        if(mode STREQUAL required)
          file(READ "${WORK}/native.report" report)
          if(NOT report MATCHES "succeeded=[1-9][0-9]*")
            message(FATAL_ERROR "Native-required fixture never entered native code: ${report}")
          endif()
        endif()
      endforeach()
    endforeach()
    file(SHA256 "${binary}" after)
    if(NOT before STREQUAL after)
      message(FATAL_ERROR "Execution modified the saved program")
    endif()
  endforeach()
endforeach()
