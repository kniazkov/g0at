cmake_minimum_required(VERSION 3.13)
file(REMOVE_RECURSE "${WORK}")
set(project "${WORK}/project with spaces")
set(input "${project}/build with spaces")
file(MAKE_DIRECTORY "${project}/scripts" "${input}" "${WORK}/elsewhere")
configure_file("${PUBLISH}" "${project}/scripts/publish_tools.cmake" COPYONLY)
set(suffix "")
if(CMAKE_HOST_WIN32)
  set(suffix .exe)
endif()
foreach(tool goat goat-inspect goat-merge)
  execute_process(COMMAND "${CMAKE_COMMAND}" -E copy "${${tool}}" "${input}/${tool}${suffix}"
    RESULT_VARIABLE result)
  if(NOT result STREQUAL "0")
    message(FATAL_ERROR "Cannot prepare ${tool}")
  endif()
endforeach()
function(publish success)
  execute_process(COMMAND "${CMAKE_COMMAND}" "-DGOAT_BUILD_DIR=build with spaces"
    -P "${project}/scripts/publish_tools.cmake" WORKING_DIRECTORY "${WORK}/elsewhere"
    RESULT_VARIABLE result OUTPUT_VARIABLE out ERROR_VARIABLE err)
  if(success AND NOT result STREQUAL "0")
    message(FATAL_ERROR "Publication failed: ${out}${err}")
  elseif(NOT success AND result STREQUAL "0")
    message(FATAL_ERROR "Publication unexpectedly succeeded")
  elseif(NOT success AND out MATCHES "Published goat")
    message(FATAL_ERROR "Failed publication reported success")
  endif()
endfunction()
function(check_tools)
  foreach(tool goat goat-inspect goat-merge)
    file(SHA256 "${input}/${tool}${suffix}" expected)
    file(SHA256 "${project}/target/${tool}${suffix}" actual)
    if(NOT actual STREQUAL expected)
      message(FATAL_ERROR "Wrong published ${tool}")
    endif()
  endforeach()
  file(WRITE "${WORK}/hello.goat" "println(42);\n")
  execute_process(COMMAND "${project}/target/goat${suffix}" "${WORK}/hello.goat"
    RESULT_VARIABLE result OUTPUT_VARIABLE out ERROR_VARIABLE err)
  string(REPLACE "\r\n" "\n" out "${out}")
  if(NOT result STREQUAL "0" OR NOT out STREQUAL "42\n")
    message(FATAL_ERROR "Published executable cannot run: ${result} ${out}${err}")
  endif()
endfunction()
publish(TRUE)
check_tools()
file(GLOB outputs RELATIVE "${project}/target" "${project}/target/*")
list(LENGTH outputs count)
if(NOT count EQUAL 3 OR EXISTS "${WORK}/elsewhere/target")
  message(FATAL_ERROR "Publication copied extra files or used the caller's directory")
endif()
# Refresh every tool, even when an old target already exists.
foreach(tool goat goat-inspect goat-merge)
  file(WRITE "${project}/target/${tool}${suffix}" "stale")
endforeach()
publish(TRUE)
check_tools()
# A missing member must fail before replacing any of the old set.
file(RENAME "${input}/goat-merge${suffix}" "${input}/saved-merge")
file(WRITE "${project}/target/goat${suffix}" "keep old executable")
publish(FALSE)
file(READ "${project}/target/goat${suffix}" old)
if(NOT old STREQUAL "keep old executable")
  message(FATAL_ERROR "Missing input partially replaced the old publication")
endif()
file(RENAME "${input}/saved-merge" "${input}/goat-merge${suffix}")
# An obstructed destination must not be mistaken for a successful copy.
file(REMOVE "${project}/target/goat${suffix}")
file(MAKE_DIRECTORY "${project}/target/goat${suffix}")
publish(FALSE)
file(REMOVE_RECURSE "${project}/target")
file(WRITE "${project}/target" "not a directory")
publish(FALSE)
file(REMOVE "${project}/target")
publish(TRUE)
check_tools()
message(STATUS "Publication: creation, refresh, foreign cwd, executable permissions and failures passed")
