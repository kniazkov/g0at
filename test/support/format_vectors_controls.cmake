# Exercise the generator only in a dedicated build-tree root. Checks must never
# repair missing/stale output, create directories, or change timestamps/bytes.
foreach(required GENERATOR ROOT WORK)
  if(NOT DEFINED ${required} OR "${${required}}" STREQUAL "")
    message(FATAL_ERROR "Missing ${required}")
  endif()
endforeach()
set(source "${ROOT}/docs/module-format-v1/schema-source.json")
string(RANDOM LENGTH 16 ALPHABET 0123456789abcdef nonce)
set(destination "${WORK}/format-vector-controls-Я space-${nonce}")
# The randomized child is owned by this test. Never remove the supplied WORK.
if(EXISTS "${destination}")
  message(FATAL_ERROR "Control destination unexpectedly exists")
endif()
file(SHA256 "${source}" source_before)
function(run expected)
  execute_process(COMMAND "${GENERATOR}" ${ARGN}
    RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error TIMEOUT 30)
  if(expected STREQUAL "success")
    if(NOT result STREQUAL "0")
      message(FATAL_ERROR "Generator failed: ${result}\n${output}${error}")
    endif()
  elseif(result STREQUAL "0")
    message(FATAL_ERROR "Generator unexpectedly accepted: ${ARGN}")
  elseif(NOT result MATCHES "^[0-9]+$")
    message(FATAL_ERROR "Generator did not exit normally: ${result}\n${output}${error}")
  endif()
endfunction()
run(failure --check --root "${destination}" --source "${source}")
if(EXISTS "${destination}")
  message(FATAL_ERROR "Check created absent destination")
endif()
run(failure --write)
run(failure --write --check --root "${destination}" --source "${source}")
run(success --write --root "${destination}" --source "${source}")
set(base "${destination}/docs/module-format-v1")
file(GLOB_RECURSE outputs RELATIVE "${base}" "${base}/*")
list(LENGTH outputs count)
if(NOT count EQUAL 26)
  message(FATAL_ERROR "Expected 26 generated files, got ${count}")
endif()
foreach(relative IN LISTS outputs)
  file(SHA256 "${base}/${relative}" actual)
  file(SHA256 "${ROOT}/docs/module-format-v1/${relative}" expected)
  if(NOT actual STREQUAL expected)
    message(FATAL_ERROR "Roundtrip differs: ${relative}")
  endif()
endforeach()
run(success --root "${destination}" --source "${source}")
# Exercise missing and stale detection for every emitted artifact, not just one.
foreach(relative IN LISTS outputs)
  set(path "${base}/${relative}")
  file(RENAME "${path}" "${path}.saved")
  run(failure --check --root "${destination}" --source "${source}")
  if(EXISTS "${path}")
    message(FATAL_ERROR "Check restored missing file: ${relative}")
  endif()
  file(RENAME "${path}.saved" "${path}")
  file(APPEND "${path}" "stale")
  file(SHA256 "${path}" before)
  file(TIMESTAMP "${path}" stamp_before "%s")
  run(failure --check --root "${destination}" --source "${source}")
  file(SHA256 "${path}" after)
  file(TIMESTAMP "${path}" stamp_after "%s")
  if(NOT before STREQUAL after OR NOT stamp_before STREQUAL stamp_after)
    message(FATAL_ERROR "Check mutated stale file: ${relative}")
  endif()
  # Explicit write repairs the destination and proves regeneration is reusable.
  run(success --write --root "${destination}" --source "${source}")
endforeach()
run(success --check --root "${destination}" --source "${source}")
# Match every historical schema._load_source rejection case. The strict oracle
# parser rejects duplicate decoded keys and non-integer number tokens recursively.
set(invalid_sources
  [=[[]]=]
  [=[null]=]
  [=[{"DEFS":{},"ROOTS":[]}]=]
  [=[{"DEFS":{},"ROOTS":{},"extra":{}}]=]
  [=[{"DEFS":{},"ROOTS":{},"DEFS":{}}]=]
  [=[{"DEFS":{"a":1,"\u0061":2},"ROOTS":{}}]=]
  [=[{"DEFS":{"n":1.0},"ROOTS":{}}]=]
  [=[{"DEFS":{"n":1e0},"ROOTS":{}}]=]
  [=[{"DEFS":{"n":NaN},"ROOTS":{}}]=]
  [=[{"DEFS":{"n":Infinity},"ROOTS":{}}]=]
  [=[{"DEFS":{"n":-Infinity},"ROOTS":{}}]=])
set(bad_source "${WORK}/invalid-vector-source-Я space-${nonce}.json")
foreach(invalid IN LISTS invalid_sources)
  file(WRITE "${bad_source}" "${invalid}")
  file(SHA256 "${bad_source}" bad_before)
  run(failure --write --root "${destination}-absent" --source "${bad_source}")
  if(EXISTS "${destination}-absent")
    message(FATAL_ERROR "Invalid schema source created output")
  endif()
  foreach(relative IN LISTS outputs)
    file(TIMESTAMP "${base}/${relative}" before_${relative} "%s")
  endforeach()
  run(failure --write --root "${destination}" --source "${bad_source}")
  foreach(relative IN LISTS outputs)
    file(SHA256 "${base}/${relative}" actual)
    file(SHA256 "${ROOT}/docs/module-format-v1/${relative}" expected)
    file(TIMESTAMP "${base}/${relative}" after_stamp "%s")
    if(NOT actual STREQUAL expected OR NOT after_stamp STREQUAL "${before_${relative}}")
      message(FATAL_ERROR "Invalid schema source changed ${relative}")
    endif()
  endforeach()
  file(SHA256 "${bad_source}" bad_after)
  if(NOT bad_before STREQUAL bad_after)
    message(FATAL_ERROR "Generator modified invalid source")
  endif()
endforeach()
file(REMOVE "${bad_source}")
file(SHA256 "${source}" source_after)
if(NOT source_before STREQUAL source_after)
  message(FATAL_ERROR "Generator changed schema source")
endif()
if(NOT KEEP_WORK)
  file(REMOVE_RECURSE "${destination}")
else()
  message(STATUS "Retained vector controls: ${destination}")
endif()
message(STATUS "26 roundtrip, 26 missing and 26 stale and 11 invalid-source vector controls passed")
