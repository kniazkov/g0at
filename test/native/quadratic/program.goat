// Quadratic equation a*x*x + b*x + c = 0, with real coefficients and a != 0.
const quadratic = func(a, b, c) {
    const d = b * b - 4.0 * a * c;
    if (d < 0.0) return "Нет корней";
    const scale = 0.5 * pow(a, -1.0);
    if (d == 0.0) return "Один корень: " + (-b * scale);
    const root = sqrt(d);
    return "Два корня: " + ((-b - root) * scale) + ", " + ((-b + root) * scale);
};

println(quadratic(1.0, 0.0, 1.0));
println(quadratic(1.0, -2.0, 1.0));
println(quadratic(1.0, -3.0, 2.0));
