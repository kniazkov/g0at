const identity = func(value) { return value; };
const negate = func(value) { return !value; };
const truth = func(value) { return !!value; };
const both = func(a, b) { return a && b; };
const either = func(a, b) { return a || b; };
const equal = func(a, b) { return a == b; };
const less = func(a, b) { return a < b; };
const choose = func(flag, a, b) { var result = a; if (flag) result = b; return result; };
const nested = func(flag, ch) { return choose(negate(flag), ch, identity('Z')); };
const recurse = func(n, flag) { if (n <= 0) return flag; return recurse(n - 1, !flag); };
const character = func(s, n) { return s.charAt(n); };
const contains = func(s, needle) { return s.contains(needle); };
const empty = func(s) { return s.isEmpty(); };
const concat = func(a, b) { return a + b; };
const safeAnd = func(flag, s, n) { return flag && s.charAt(n) == 'A'; };
const safeOr = func(flag, s, n) { return flag || s.charAt(n) == 'A'; };
const effects = func(flag) {
    var n = 0;
    var a = flag && ++n;
    var b = flag || ++n;
    return "%0:%1:%2".format(a, b, n);
};
const relations = func(a, b) {
    return "%0,%1,%2,%3,%4,%5".format(a < b, a <= b, a > b, a >= b, a == b, a != b);
};
const charCondition = func(ch) { if (ch) return true; return false; };
const asInteger = func(flag) { return int(flag); };
const loop = func(ch) {
    var done = false;
    var result = ch;
    for (var n = 0; !done; n++) {
        result = chr(ord(result) + 1);
        done = n >= 2;
    }
    return result;
};
println(identity(true));
println(identity(false));
println(ord(identity(chr(0))));
println(ord(identity(chr(4294967295))));
println(identity('Ж'));
println(identity('😀'));
println(identity(1));
println(identity(1.5));
println(identity("string"));
println(negate(true));
println(negate(false));
println(truth(chr(0)));
println(truth(chr(4294967295)));
println(truth(""));
println(truth("yes"));
println(both(true, true));
println(both(true, false));
println(both(false, true));
println(both(false, false));
println(either(true, true));
println(either(true, false));
println(either(false, true));
println(either(false, false));
println(equal(true, false));
println(equal(true, true));
println(equal('A', 'A'));
println(equal('A', 'B'));
println(equal('A', 65));
println(equal(65, 'A'));
println(equal(true, 1));
println(equal('A', "A"));
println(equal("true", true));
println(equal(false, chr(0)));
println(less(false, true));
println(less('A', 'B'));
println(less(chr(4294967295), chr(0)));
println(choose(true, 'A', 'B'));
println(choose(false, true, false));
println(nested(true, 'A'));
println(nested(false, 'A'));
println(character("ABC", 1));
println(contains("abc", "b"));
println(contains("abc", "z"));
println(empty(""));
println(empty("abc"));
println(concat('A', 'B'));
println(concat('A', 42));
println(concat('A', true));
println(concat('A', 0.5));
println(safeAnd(false, "", 999));
println(safeAnd(true, "A", 0));
println(safeOr(true, "", 999));
println(safeOr(false, "A", 0));
println(effects(true));
println(effects(false));
println(loop('A'));
println(asInteger(true));
println(asInteger(false));
println(relations(false, true));
println(relations('Z', 'A'));
println(relations(chr(4294967295), chr(4294967295)));
println(charCondition(chr(0)));
println(charCondition('A'));
println(ord(identity(chr(-1))));
println(recurse(10, true));
println(recurse(11, true));
