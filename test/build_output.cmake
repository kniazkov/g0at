cmake_minimum_required(VERSION 3.13)
get_filename_component(repo "${CMAKE_CURRENT_LIST_DIR}/.." ABSOLUTE)
include("${repo}/scripts/build_command.cmake")
if(NOT DEFINED WORK)
  set(WORK "${repo}/build/build-output-test")
endif()
string(RANDOM LENGTH 12 ALPHABET 0123456789abcdef run_id)
set(work "${WORK}/run-${run_id}")
set(source "${work}/source with spaces")
file(MAKE_DIRECTORY "${source}")
file(COPY "${repo}/test/src/support/build_output_fixture.c" DESTINATION "${source}")
file(WRITE "${source}/CMakeLists.txt" [=[
cmake_minimum_required(VERSION 3.13)
project(build_output_fixture C)
add_executable(emitter build_output_fixture.c)
foreach(id first second)
  if(id STREQUAL "first")
    set(peer second)
  else()
    set(peer first)
  endif()
  add_custom_target(${id}
    COMMAND emitter ${id} ${peer}
    WORKING_DIRECTORY "${CMAKE_BINARY_DIR}" VERBATIM)
endforeach()
add_custom_target(pair DEPENDS first second)
]=])

set(generators "Unix Makefiles")
if(CMAKE_HOST_WIN32)
  set(generators "MinGW Makefiles")
endif()
find_program(ninja NAMES ninja ninja-build)
if(ninja)
  list(APPEND generators Ninja)
else()
  message(FATAL_ERROR "Install Ninja to verify the non-Make generator control")
endif()
foreach(generator IN LISTS generators)
  foreach(mode Debug Release)
    set(directory "${work}/${generator} ${mode}")
    execute_process(COMMAND "${CMAKE_COMMAND}" -S "${source}" -B "${directory}"
      -G "${generator}" "-DCMAKE_BUILD_TYPE=${mode}" RESULT_VARIABLE result)
    if(NOT result STREQUAL "0")
      message(FATAL_ERROR "Cannot configure ${generator} ${mode}")
    endif()
    # Changing the environment must not override the actual cached generator.
    set(ENV{CMAKE_GENERATOR} "NMake Makefiles")
    goat_build_command(command "${directory}" --parallel 2 --target pair --config "${mode}")
    list(FIND command --output-sync=target sync)
    if(generator MATCHES "Makefiles$" AND sync EQUAL -1)
      message(FATAL_ERROR "GNU Make output synchronization missing")
    elseif(generator STREQUAL "Ninja" AND NOT sync EQUAL -1)
      message(FATAL_ERROR "GNU Make option leaked into Ninja")
    endif()
    unset(ENV{CMAKE_GENERATOR})
    # Compile the producer separately so the rendezvous only observes two jobs.
    execute_process(COMMAND "${CMAKE_COMMAND}" -P "${repo}/scripts/build_command.cmake"
      "${directory}" --parallel 2 --target emitter --config "${mode}" RESULT_VARIABLE result)
    if(NOT result STREQUAL "0")
      message(FATAL_ERROR "Cannot build diagnostic producer")
    endif()
    foreach(control success fail)
      file(REMOVE "${directory}/first" "${directory}/second")
      set(ENV{BUILD_OUTPUT_CONTROL} "${control}")
      set(log "${directory}/${control}.log")
      # Exercise the exact command-line entry used by both shell families.
      # Release also covers the inherited environment-only job selection.
      set(jobs --parallel 2)
      if(mode STREQUAL "Release")
        set(jobs)
        set(ENV{CMAKE_BUILD_PARALLEL_LEVEL} 2)
      endif()
      execute_process(COMMAND "${CMAKE_COMMAND}" -P "${repo}/scripts/build_command.cmake"
        "${directory}" ${jobs} --target pair --config "${mode}"
        RESULT_VARIABLE result OUTPUT_FILE "${log}" ERROR_FILE "${log}" TIMEOUT 60)
      if(control STREQUAL "success" AND NOT result STREQUAL "0")
        message(FATAL_ERROR "Parallel ${generator} ${mode} build failed: ${log}")
      elseif(control STREQUAL "fail" AND result STREQUAL "0")
        message(FATAL_ERROR "Build failure swallowed: ${log}")
      endif()
      file(READ "${log}" output)
      string(REPLACE "\r\n" "\n" output "${output}")
      foreach(id first second)
        foreach(stream stdout stderr)
          foreach(line RANGE 0 3)
            if(NOT output MATCHES "${stream}-${id}-${line}:complete\n")
              message(FATAL_ERROR "Interleaved/missing diagnostic in ${log}: ${stream}-${id}-${line}")
            endif()
          endforeach()
        endforeach()
        if(NOT output MATCHES "warning: complete warning from ${id}\n")
          message(FATAL_ERROR "Warning missing: ${log}")
        endif()
      endforeach()
      if(control STREQUAL "fail" AND NOT output MATCHES "fatal error: deliberate fixture failure [(]first[)]\n")
        message(FATAL_ERROR "Fatal diagnostic missing: ${log}")
      endif()
      message(STATUS "PASS ${generator} ${mode} ${control}: intact diagnostics and concurrent jobs")
    endforeach()
  endforeach()
endforeach()

# Fake caches verify unsupported generators and non-GNU make without invoking
# the wrong backend. The helper must not change the caller's build arguments.
set(cache "${work}/cache with spaces")
file(MAKE_DIRECTORY "${cache}")
foreach(generator "Ninja Multi-Config" "NMake Makefiles" "Visual Studio 17 2022" "Unix Makefiles")
  file(WRITE "${cache}/CMakeCache.txt" "CMAKE_GENERATOR:INTERNAL=${generator}\nCMAKE_MAKE_PROGRAM:FILEPATH=${CMAKE_COMMAND}\n")
  goat_build_command(command "${cache}" --parallel 7 --target example --config Release)
  set(expected "${CMAKE_COMMAND};--build;${cache};--parallel;7;--target;example;--config;Release")
  if(NOT command STREQUAL expected)
    message(FATAL_ERROR "Unexpected options for ${generator}: ${command}")
  endif()
endforeach()

# Probe old/current GNU Make output and the existing native-argument separator.
# Reuse the compiled fixture only as a --version responder, never as a backend.
set(emitter "${directory}/emitter")
if(CMAKE_HOST_WIN32)
  string(APPEND emitter .exe)
endif()
foreach(generator "Unix Makefiles" "MinGW Makefiles" "MSYS Makefiles")
  file(WRITE "${cache}/CMakeCache.txt" "CMAKE_GENERATOR:INTERNAL=${generator}\nCMAKE_MAKE_PROGRAM:FILEPATH=${emitter}\n")
  foreach(version 3.82 4.0 4.4.1)
    set(ENV{BUILD_OUTPUT_MAKE_VERSION} "${version}")
    goat_build_command(command "${cache}" --parallel 7 -- --no-print-directory)
    set(expected "${CMAKE_COMMAND};--build;${cache};--parallel;7;--;--no-print-directory")
    if(NOT version VERSION_LESS "4.0")
      list(APPEND expected --output-sync=target)
    endif()
    if(NOT command STREQUAL expected)
      message(FATAL_ERROR "Wrong GNU Make ${version} / ${generator} options: ${command}")
    endif()
  endforeach()
endforeach()

# Run the actual shell entrypoints against a compiler failure. They must stop
# before packaging/publication and preserve the compiler's warning and error.
set(fixture "${work}/shell fixture with spaces")
file(MAKE_DIRECTORY "${fixture}/scripts")
file(COPY "${repo}/scripts/build.sh" "${repo}/scripts/build_release.sh"
  "${repo}/scripts/build_mingw.cmd" "${repo}/scripts/build_release_mingw.cmd"
  "${repo}/scripts/build_command.cmake" DESTINATION "${fixture}/scripts")
file(WRITE "${fixture}/broken.c" "#warning issue489 complete compiler warning\n#error issue489 deliberate compiler failure\n")
file(WRITE "${fixture}/scripts/publish_tools.cmake"
  "file(WRITE \"${fixture}/published-after-failure\" \"unexpected\")\n")
file(WRITE "${fixture}/CMakeLists.txt" [=[
cmake_minimum_required(VERSION 3.13)
project(shell_failure_fixture C)
add_executable(goat broken.c)
add_custom_target(process_exit_delayed_testing DEPENDS goat)
add_custom_target(package COMMAND "${CMAKE_COMMAND}" -E touch "${CMAKE_SOURCE_DIR}/packaged-after-failure")
]=])
unset(ENV{BUILD_DIR})
set(ENV{CMAKE_BUILD_PARALLEL_LEVEL} 2)
set(ENV{CMAKE_GENERATOR} "Unix Makefiles")
foreach(mode debug release)
  if(CMAKE_HOST_WIN32)
    set(script build_mingw.cmd)
    if(mode STREQUAL "release")
      set(script build_release_mingw.cmd)
    endif()
    set(command cmd /d /c call "${fixture}/scripts/${script}")
  else()
    find_program(bash bash)
    set(script build.sh)
    if(mode STREQUAL "release")
      set(script build_release.sh)
    endif()
    set(command "${bash}" "${fixture}/scripts/${script}")
  endif()
  if(mode STREQUAL "debug")
    list(APPEND command --build-only 2)
  endif()
  set(log "${work}/shell-${mode}-failure.log")
  execute_process(COMMAND ${command} WORKING_DIRECTORY "${work}"
    RESULT_VARIABLE result OUTPUT_FILE "${log}" ERROR_FILE "${log}" TIMEOUT 60)
  file(READ "${log}" output)
  if(result STREQUAL "0" OR NOT output MATCHES "issue489 complete compiler warning"
      OR NOT output MATCHES "issue489 deliberate compiler failure"
      OR output MATCHES "Build done[.]|Done[.]")
    message(FATAL_ERROR "Shell entrypoint lost compiler failure: ${log}")
  endif()
  if(mode STREQUAL "release" AND (NOT output MATCHES "Building Release tools"
      OR output MATCHES "Building Release package|Publishing Release tools"))
    message(FATAL_ERROR "Release stage markers missing or continued after failure: ${log}")
  endif()
  if(EXISTS "${fixture}/published-after-failure" OR EXISTS "${fixture}/packaged-after-failure")
    message(FATAL_ERROR "Shell entrypoint continued after compiler failure: ${log}")
  endif()
endforeach()
message(STATUS "Build output controls passed")
