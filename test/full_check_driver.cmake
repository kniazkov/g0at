# Exercise the real orchestration against a tiny project, including failure paths.
cmake_minimum_required(VERSION 3.21)
get_filename_component(repo "${CMAKE_CURRENT_LIST_DIR}/.." ABSOLUTE)
if(NOT DEFINED WORK)
  set(WORK "${repo}/build/full-check-driver-test")
endif()
get_filename_component(WORK "${WORK}" ABSOLUTE BASE_DIR "${repo}")
include("${repo}/scripts/full_check_release.cmake")
file(READ "${repo}/.github/workflows/build_and_test.yml" workflow)
string(FIND "${workflow}" "-L \"${release_labels}\"" release_selection)
if(release_selection EQUAL -1)
  message(FATAL_ERROR "Local Release labels drifted from CI; review full_check_release.cmake")
endif()
string(RANDOM LENGTH 12 ALPHABET 0123456789abcdef run_id)
set(WORK "${WORK}/run-${run_id}")
set(fixture "${WORK}/fixture with spaces")
file(MAKE_DIRECTORY "${fixture}/scripts" "${fixture}/tools/unicode" "${fixture}/tools/module-schema")
file(COPY "${repo}/scripts/build_command.cmake" "${repo}/scripts/full_check.cmake" "${repo}/scripts/full_check_release.cmake" "${repo}/scripts/publish_tools.cmake" DESTINATION "${fixture}/scripts")
file(WRITE "${fixture}/dummy.c" "int main(void) { return 0; }\n")
file(WRITE "${fixture}/CMakeLists.txt" [=[
cmake_minimum_required(VERSION 3.21)
project(full_check_fixture C)
enable_testing()
set(CMAKE_RUNTIME_OUTPUT_DIRECTORY "${CMAKE_BINARY_DIR}")
add_executable(goat dummy.c)
foreach(target goat-inspect goat-merge functional_testing package_scenarios module_delivery_scenarios module_json_testing)
  add_custom_command(TARGET goat POST_BUILD COMMAND "${CMAKE_COMMAND}" -E copy
    "$<TARGET_FILE:goat>" "${CMAKE_BINARY_DIR}/${target}${CMAKE_EXECUTABLE_SUFFIX}")
  add_custom_target(${target} DEPENDS goat)
endforeach()
foreach(target module_memory_scenarios module_json_scenarios module_canonical_hash_scenarios format_binary_ubsan_testing format_oracle_ubsan_testing integer_oracle_ubsan_testing)
  add_custom_target(${target} DEPENDS module_json_testing)
endforeach()
# Exercise real CPack, including the direct Windows invocation.
install(TARGETS goat RUNTIME DESTINATION bin)
set(CPACK_GENERATOR ZIP)
set(CPACK_PACKAGE_DIRECTORY "${CMAKE_BINARY_DIR}/packages")
include(CPack)
set(core_result true)
if(CMAKE_BUILD_TYPE STREQUAL "Release" OR "$ENV{FULL_CHECK_FIXTURE_FAILURE}" STREQUAL "test")
  # Running Debug-only assertions in Release must make the control fail.
  set(core_result false)
endif()
add_test(NAME core.unit COMMAND "${CMAKE_COMMAND}" -E ${core_result})
add_test(NAME safe.fixture COMMAND "${CMAKE_COMMAND}" -E true)
set_tests_properties(safe.fixture PROPERTIES LABELS "module-memory-migration;module-schema")
add_test(NAME package.relocated COMMAND "${CMAKE_COMMAND}" -E touch "${CMAKE_BINARY_DIR}/package-tested")
foreach(name format.reference integration.native_performance.benchmark native.module_json)
  add_test(NAME ${name} COMMAND "${CMAKE_COMMAND}" -E true)
endforeach()
if(NOT EXISTS "${CMAKE_BINARY_DIR}/packages")
  set_tests_properties(package.relocated PROPERTIES DISABLED TRUE)
endif()
if(CMAKE_BUILD_TYPE STREQUAL "Debug" AND "$ENV{FULL_CHECK_FIXTURE_FAILURE}" STREQUAL "build")
  add_custom_target(deliberate_failure ALL COMMAND "${CMAKE_COMMAND}" -E false)
endif()
]=])
foreach(tool unicode module-schema)
  file(WRITE "${fixture}/tools/${tool}/CMakeLists.txt" "cmake_minimum_required(VERSION 3.21)\nproject(host_fixture C)\nenable_testing()\nadd_test(NAME host.check COMMAND \"\${CMAKE_COMMAND}\" -E true)\n")
endforeach()
foreach(script native_modes binary_program)
  file(WRITE "${fixture}/scripts/check_${script}.sh" "#!/usr/bin/env bash\nset -eu\ntest -f \"$1\"\ntest -f \"$2\"\n")
endforeach()
# Cross-runtime compilers are not used by this fixture; satisfy preflight with
# the actual host compiler without weakening production preflight.
if(CMAKE_HOST_WIN32)
  find_program(gcc gcc REQUIRED)
  set(ENV{GOAT_DELIVERY_MINGW64_CC} "${gcc}")
  set(ENV{GOAT_DELIVERY_UCRT64_CC} "${gcc}")
endif()
set(suffix "")
if(CMAKE_HOST_WIN32)
  set(suffix .exe)
endif()
foreach(control success test build publish)
  set(ENV{FULL_CHECK_DIR} "${WORK}/${control} output")
  set(ENV{FULL_CHECK_FIXTURE_FAILURE} "${control}")
  # Failed checks must preserve the previously published set.
  if(NOT control STREQUAL "success")
    foreach(tool goat goat-inspect goat-merge)
      file(WRITE "${fixture}/target/${tool}${suffix}" "previous ${tool}")
    endforeach()
  endif()
  if(control STREQUAL "publish")
    file(REMOVE "${fixture}/target/goat${suffix}")
    file(MAKE_DIRECTORY "${fixture}/target/goat${suffix}")
  endif()
  execute_process(COMMAND "${CMAKE_COMMAND}" -DGOAT_FULL_JOBS=2 -P "${fixture}/scripts/full_check.cmake"
    RESULT_VARIABLE result OUTPUT_FILE "${WORK}/${control}.log" ERROR_FILE "${WORK}/${control}.log")
  if(control STREQUAL "success")
    if(NOT result STREQUAL "0")
      message(FATAL_ERROR "Full-check success control failed: ${WORK}/${control}.log")
    endif()
  elseif(result STREQUAL "0")
    message(FATAL_ERROR "Full check swallowed the ${control} failure")
  endif()
  file(READ "$ENV{FULL_CHECK_DIR}/summary.txt" summary)
  foreach(phase release-tests release-package-test release-performance host-unicode-tests host-module-schema-tests)
    if(NOT summary MATCHES "PASS ${phase}\n")
      message(FATAL_ERROR "Missing independent phase ${phase}: ${control}")
    endif()
  endforeach()
  file(GLOB packages "$ENV{FULL_CHECK_DIR}/release/packages/*.zip")
  list(LENGTH packages package_count)
  if(NOT package_count EQUAL 1)
    message(FATAL_ERROR "Expected one real package archive: ${control}")
  endif()
  list(GET packages 0 package_archive)
  set(unpacked "$ENV{FULL_CHECK_DIR}/unpacked-control")
  file(ARCHIVE_EXTRACT INPUT "${package_archive}" DESTINATION "${unpacked}")
  file(GLOB_RECURSE packaged_tools "${unpacked}/*/bin/goat${suffix}")
  list(LENGTH packaged_tools packaged_count)
  if(NOT packaged_count EQUAL 1)
    message(FATAL_ERROR "Package is missing the fixture executable: ${control}")
  endif()
  if(NOT EXISTS "$ENV{FULL_CHECK_DIR}/release/package-tested")
    message(FATAL_ERROR "Release package test was disabled or never executed")
  endif()
  if(control STREQUAL "success")
    if(NOT summary MATCHES "PASS publish-tools")
      message(FATAL_ERROR "Successful checks did not publish tools")
    endif()
    foreach(tool goat goat-inspect goat-merge)
      file(SHA256 "$ENV{FULL_CHECK_DIR}/release/${tool}${suffix}" expected)
      file(SHA256 "${fixture}/target/${tool}${suffix}" actual)
      if(NOT expected STREQUAL actual)
        message(FATAL_ERROR "Wrong published ${tool}")
      endif()
    endforeach()
  elseif(control STREQUAL "publish")
    if(NOT summary MATCHES "FAIL publish-tools")
      message(FATAL_ERROR "Publication failure not reported")
    endif()
  else()
    if(summary MATCHES "(PASS|FAIL) publish-tools")
      message(FATAL_ERROR "Published despite failed checks")
    endif()
    foreach(tool goat goat-inspect goat-merge)
      file(READ "${fixture}/target/${tool}${suffix}" previous)
      if(NOT previous STREQUAL "previous ${tool}")
        message(FATAL_ERROR "Failed checks replaced ${tool}")
      endif()
    endforeach()
  endif()
  if(control STREQUAL "test" AND NOT summary MATCHES "FAIL debug-tests")
    message(FATAL_ERROR "Test failure not reported")
  elseif(control STREQUAL "build")
    if(NOT summary MATCHES "FAIL debug-build" OR summary MATCHES "(PASS|FAIL) debug-tests")
      message(FATAL_ERROR "Build failure not reported, or stale tests were run")
    endif()
  endif()
endforeach()
message(STATUS "Full-check driver controls passed (success, test/build/publication failures, paths with spaces)")
