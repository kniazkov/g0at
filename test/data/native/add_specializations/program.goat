// One Goat function, seven native signatures; repeat them with different values.
const add = func(a, b) {
    return a + b;
};

println(add(20, 22));
println(add(2, 0.5));
println(add(0.5, 2));
println(add(1.25, 2.5));
println(add("Hello, ", "world!"));
println(add("integer=", 42));
println(add("real=", 2.5));

// Reverse the order to exercise dispatch between existing specializations.
println(add("real=", -0.25));
println(add("integer=", -7));
println(add("", "Привет 😀"));
println(add(-1.5, 0.25));
println(add(-0.5, 3));
println(add(-3, 0.25));
println(add(-20, 5));
