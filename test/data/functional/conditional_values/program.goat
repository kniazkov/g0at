println(true ? 1 : 2);
println(false ? 1 : "no");
println(null ? "bad" : "null");
println(0 ? "bad" : "zero");
println(-1 ? "negative" : "bad");
println(0.0 ? "bad" : "real zero");
println("" ? "bad" : "empty");
println("x" ? "text" : "bad");
println('a' ? "char" : "bad");
var a=[1]; var b={var x=2;};
println((true ? a : b)==a);
println((false ? a : b)==b);
println((true ? func(){return 3;} : func(){return 4;})());
println((false ? [1] : [2])[0]);
println((true ? {var x=5;} : {var x=6;}).x);
println([] ? "bad" : "empty array");
println([0] ? "array" : "bad");
println({} ? "bad" : "empty object");
println({var x=0;} ? "object" : "bad");
println(func(){} ? "function" : "bad");
println(sqrt(-1) ? "nan" : "bad");
