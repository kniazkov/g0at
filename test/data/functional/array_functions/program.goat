var identity = func(a) { return a }
var make = func(x) { return [x, x+1,] }
var a = make(10)
println(identity(a) == a)
println(make(20))
println(make(30)[1])
var functions = [func(x) { return x * 2 }, func(x) { return [x] }]
println(functions[0](5))
println(functions[1](7)[0])
var object = { var items = [1, 2] }
object.items[0] = 9
println(object.items)
var factory = func() { var a = [1]; return func() { a[0] = a[0]+1; return a[0] } }
var counter = factory()
println(counter())
println(counter())
