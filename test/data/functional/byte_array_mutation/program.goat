const twice = func(n) { return n * 2; };
if (twice(21) != 42) throw "native seed";
const check = func(ok) { if (!ok) throw "check failed"; };
const invalid = func(f) {
    var caught = false;
    try { f(); } catch(e) { caught = true; check(str(e) == "INVALID_ARGUMENT"); }
    check(caught);
};
const immutable = func(f) {
    var caught = false;
    try { f(); } catch(e) { caught = true; check(str(e) == "IMMUTABLE_OBJECT"); }
    check(caught);
};
var a = ByteArray -> {};
var alias = a << 0 << 255;
alias[0] = 17;
check(a[0] == 17 && a.length == 2);
a.shrinkToFit();
a.append(a);
check(a.length == 4 && a[2] == 17 && a[3] == 255);
a.append(a, 1, 2);
check(a.length == 6 && a[4] == 255 && a[5] == 17);
var b = ByteArray -> {};
b.append(a, 4);
check(b.length == 2 && b[0] == 255 && b[1] == 17);
b.append(a, a.length, 0).append(ByteArray -> {});
check(b.length == 2);
invalid(func() { a.append(); });
invalid(func() { a.append(255, 0); });
invalid(func() { a.append(a, 0, 1, 2); });
invalid(func() { a.append(a, 7, 0); });
invalid(func() { a.append(a, 5, 2); });
invalid(func() { a.append(a, -1); });
invalid(func() { a.append(a, 0, -1); });
invalid(func() { a.append(a, 0.0); });
invalid(func() { a.append(a, 0, 1.0); });
invalid(func() { a.append(-1); });
invalid(func() { a.append(256); });
invalid(func() { a.append(1.0); });
invalid(func() { a.append(true); });
invalid(func() { a.append("1"); });
invalid(func() { a << null; });
invalid(func() { a.resize(); });
invalid(func() { a.resize(-1); });
invalid(func() { a.resize(1.0); });
invalid(func() { a.resize(1, 0, 0); });
invalid(func() { a.resize(2, 256); });
invalid(func() { a.resize(6, -1); });
invalid(func() { a.resize(6, 0.0); });
invalid(func() { a.resize(0, true); });
invalid(func() { a.clear(1); });
invalid(func() { a.shrinkToFit(1); });
check(a.length == 6 && a[0] == 17 && a[1] == 255 && a[5] == 17);
var r = a.resize(1);
r[0] = 42;
check(a[0] == 42);
a.resize(3);
check(a[0] == 42 && a[1] == 0 && a[2] == 0);
a.resize(5, 255);
check(a[2] == 0 && a[3] == 255 && a[4] == 255);
r = a.shrinkToFit();
r[0] = 43;
check(a[0] == 43);
r = a.clear();
r.append(9);
check(a.length == 1 && a[0] == 9);
a.clear().shrinkToFit().resize(2, 7);
check(a.length == 2 && a[0] == 7 && a[1] == 7);
r = a.append(8);
r[0] = 6;
check(a[0] == 6);
var child = a -> {};
child << 99;
check(child.length == 1 && a.length == 3);
var copy = a.clone();
copy.append(10);
check(a.length == 3 && copy.length == 4);
var flat = a.flat();
flat.resize(1).append(11);
check(flat.length == 2 && a.length == 3);
immutable(func() { ByteArray.append(0); });
immutable(func() { ByteArray << 0; });
immutable(func() { ByteArray.resize(0); });
immutable(func() { ByteArray.clear(); });
immutable(func() { ByteArray.shrinkToFit(); });
var caught = false;
try { a + 1; } catch(e) { caught = true; }
check(caught);
caught = false;
try { a += 1; } catch(e) { caught = true; }
check(caught && a.length == 3);
println("byte-array mutation ok");
