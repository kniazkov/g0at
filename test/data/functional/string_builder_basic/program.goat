const twice = func(n) { return n * 2; };
if (twice(21) != 42) throw "native seed";
var b = StringBuilder -> {};
println(b.instanceOf(StringBuilder));
println(b.length);
println(str(b) == "");
b += "test";
b += ' ';
const alias = b;
println((b += 123) == b);
println(str(alias));
println(b.toString());
println(b.length);
println((b << "!" << ' ' << 456) == b);
println(b.append("?").append(7) == b);
const snapshot = str(b);
const second = b.toString();
println(b.clear() == b);
println(b.length);
println(str(b) == "");
b << "new";
println(snapshot);
println(second);
println(str(b));
println((b + "!") == b);
println(str(b));
