        x14 = x13;
        x13 = x12;
        x12 = x11;
        x11 = x10;
        x10 = x9;
        x9 = x8;
        x8 = x7;
        x7 = x6;
        x6 = x5;
        x5 = x4;
        x4 = x3;
        x3 = x2;
        x2 = x1;
        x1 = x0;
        x0 = "changed";
    }
    return x31;
};
println(chain(40));
