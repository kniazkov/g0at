
const good = func(s) { return s.trim(); };
const bad = func(s, n) { return "" + s.contains(n); };
const missing = func(s) { return s.substring(); };
println(good(" ok "));
try { bad("abc", 1); } catch(e) { println("bad needle: " + e); }
try { missing("abc"); } catch(e) { println("missing index: " + e); }
