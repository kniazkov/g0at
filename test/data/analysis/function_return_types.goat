const identity = func(n) { return n; }
identity(10)
identity(20)
identity(1.5)
identity(true)
identity("abc")
identity()
const sum = func(a, b) { return a + b; }
sum(1, 2)
sum(1, 2.5)
const choice = func(n) { if (n == 1) return 0; return "other"; }
choice(1)
const numeric = func(n) { if (n) return 1; return 2.5; }
numeric(true)
