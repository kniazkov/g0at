  {
    "id": "integration.module_threads.main-ready-function",
    "name": "main-ready-function",
    "steps": [
      {
        "kind": "compile",
        "name": "app",
        "code": "const f = func(x) { return x + 1; }; const t = spawn(f, 41); println(join(t)); println(join(t)); println(\"main-end\");",
        "version": "1",
        "files": {}
      },
      {
        "kind": "invoke",
        "argv": [
          "$HOST",
          "binary",
          "$ROOT/app.gbin"
        ],
        "expected": "42\n42\nmain-end\n",
        "status": 0,
        "stderr_policy": "ignore",
        "cwd": "unrelated"
      },
      {
        "kind": "invoke",
        "argv": [
          "$GOAT",
          "--optimize",
          "none",
          "--native",
          "off",
          "$ROOT/sources/app-1/main.goat"
        ],
        "expected": "42\n42\nmain-end\n",
        "status": 0,
        "stderr_policy": "ignore",
        "cwd": "unrelated"
      },
      {
        "kind": "invoke",
        "argv": [
          "$GOAT",
          "--optimize",
          "all",
          "--native",
          "off",
          "$ROOT/sources/app-1/main.goat"
        ],
        "expected": "42\n42\nmain-end\n",
        "status": 0,
        "stderr_policy": "ignore",
        "cwd": "unrelated"
      },
      {
        "kind": "invoke",
        "argv": [
          "$GOAT",
          "--optimize",
          "all",
          "--native",
          "auto",
          "$ROOT/sources/app-1/main.goat"
        ],
        "expected": "42\n42\nmain-end\n",
        "status": 0,
        "stderr_policy": "ignore",
        "cwd": "unrelated"
      }
    ]
  },
