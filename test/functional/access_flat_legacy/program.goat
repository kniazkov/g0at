var counter = 0;
const original = {
    var x = 1;
    f = func() { counter += 1; x += 1; return x; };
    g = f;
};
var copy = original.flat();
println(copy.f == copy.g);
println(copy.f == original.f);
const detached = copy.f;
println(detached());
println(copy.x);
println(original.x);
println(counter);
var second = copy.flat();
println(second.f());
println(copy.x);
println(second.x);
println(counter);
println(second.instanceOf(original));
