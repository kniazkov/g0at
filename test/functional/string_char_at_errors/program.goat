try { println("abc".charAt()); } catch (e) { println("1:" + e); }
try { println(charAt()); } catch (e) { println("2:" + e); }
try { println(charAt(5)); } catch (e) { println("3:" + e); }
try { println(charAt(5, 0)); } catch (e) { println("4:" + e); }
try { println("abc".charAt(5)); } catch (e) { println("5:" + e); }
try { println("abc".charAt(-1)); } catch (e) { println("6:" + e); }
try { println("abc".charAt("x")); } catch (e) { println("7:" + e); }
println("done");
