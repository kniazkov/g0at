var counter = 0;
const original = {
    private var x = 10;
    public get = func() { return x; };
    public set = func(value) { x = value; };
    public viaThis = func() { return this.x; };
    public setThis = func(value) { this.x = value; };
    public next = func() { counter += 1; x += 1; return x; };
    public old = func() { return original.x; };
    public other = func(obj) { return obj.x; };
    public inner = { public read = func() { return x; }; };
    public array = [1];
};
var a = original.clone();
var b = original.clone();
a.set(20);
println(original.get());
println(a.get());
println(a.viaThis());
println(b.get());
println(a.old());
println(a.other(original));
try original.other(a); catch(e) println(e);
try a.other(b); catch(e) println(e);
println(a.inner == original.inner);
println(a.inner.read());
println(a.array == original.array);
a.array.push(2);
println(original.array);
println(a.next());
println(original.next());
println(counter);
const detached = a.get;
println(detached());
var c = a.clone();
c.set(30);
println(c.viaThis());
println(a.get());
println(original.get());
println(c.old());
try a.other(c); catch(e) println(e);
try c.get = detached; catch(e) println(e);
c.setThis(40);
println(c.get());
println(a.get());
