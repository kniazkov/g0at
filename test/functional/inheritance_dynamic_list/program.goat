const A = { var x = 1; };
const B = { var y = 2; };
var parents = [A,B];
var v = parents -> { x = 4; };
parents.clear();
println(v.x); println(v.y); println(v.instanceOf(A)); println(v.instanceOf(B));
println(([] -> {}).instanceOf(Object));
var arr = [1,2];
var child = [arr] -> {};
println(child.instanceOf(arr)); println(child.length);
