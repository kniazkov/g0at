try { println("abc".repeat()); } catch (e) { println("1:" + e); }
try { println(repeat(5, 2)); } catch (e) { println("2:" + e); }
try { println("abc".repeat("x")); } catch (e) { println("3:" + e); }
try { println("abc".repeat(-1)); } catch (e) { println("4:" + e); }
try { println(repeat()); } catch (e) { println("5:" + e); }
try { println(repeat("abc")); } catch (e) { println("6:" + e); }
println("done");
