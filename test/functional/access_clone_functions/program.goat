var obj = {
    private var n = 0;
    public f = func() { n += 1; return n; };
    public alias = f;
    public distinct = func() { n += 1; return n; };
    public even = func(value) { if (value == 0) return true; return odd(value - 1); };
    public odd = func(value) { if (value == 0) return false; return even(value - 1); };
    public recursive = func(value) { if (value == 0) return n; n += 1; return recursive(value - 1); };
};
var copy = obj.clone();
println(copy.f == copy.alias);
println(copy.f == obj.f);
println(copy.f == copy.distinct);
println(copy.f());
println(copy.alias());
println(obj.f());
println(copy.even(8));
println(copy.odd(9));
const detached = copy.recursive;
println(detached(4));
println(obj.f());
println(copy.distinct());
var second = copy.clone();
println(second.f == second.alias);
println(second.f == copy.f);
println(second.recursive(2));
println(copy.f());
var plain = { var x = 1; f = func() { x += 1; return x; }; };
var plainCopy = plain.clone();
const plainDetached = plainCopy.f;
println(plainDetached());
println(plain.x);
println(plainCopy.x);
