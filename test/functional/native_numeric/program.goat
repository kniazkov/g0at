const sum=func(a,b){return a+b;};
const difference=func(a,b){return a-b;};
const product=func(a,b){return a*b;};
const below=func(a,b){if(a<b)return 1;return 0;};
const rounded=func(n){return (n+1.0)-n;};
const negative=func(n){return -n;};
sum(1,2);sum(1.0,2.0);sum(1,2.0);sum(1.0,2);
difference(1,2);difference(1.0,2.0);difference(1,2.0);difference(1.0,2);
product(1,2);product(1.0,2.0);product(1,2.0);product(1.0,2);
below(1,2);below(1.0,2.0);below(1,2.0);below(1.0,2);
rounded(1.0);negative(1);negative(1.0);
print("MUST NOT EXECUTE");
