print(false < true); print("|");
print(true >= false); print("|");
print(null == null); print("|");
print(null != false); print("|");
print(false == 0); print("|");
print(0 == false); print("|");
print("1" == 1); print("|");
print(1 == "1"); print("|");
print(true != 1); print("|");
print(print == print); print("|");
print(print != null); print("|");
