// Vector dot product, matrix indexing and a callable object compose normally.
const vector = func(x, y) {
    const value = { var x = 0; var y = 0; };
    value.x = x;
    value.y = y;
    value["*"] = func(other) { return this.x * other.x + this.y * other.y; };
    return value;
};
const matrix = { var cells = [1, 2, 3, 4]; };
matrix["[]"] = func(row, column) { return this.cells[row * 2 + column]; };
matrix["[]="] = func(row, column, value) { this.cells[row * 2 + column] = value; };
const callable = { var calls = 0; var saved = null; };
callable["()"] = func(left, right) {
    this.calls++;
    this.saved = arguments;
    return left * right;
};
const exercise = func() {
    const a = vector(2, 3);
    const b = vector(4, 5);
    matrix[1, 0] += callable(a, b, "extra");
    println(matrix[1, 0]); // 26
    println(callable.calls); // 1
    println(callable.saved.length); // 3: this is not an argument
    println(callable.saved[2]); // extra
};
exercise();
