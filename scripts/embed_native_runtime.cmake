# Embed public headers and the built static library as byte arrays; invoked by the build, not edited by hand.
if(NOT DEFINED INPUT_DIR OR NOT DEFINED OUTPUT_FILE OR NOT DEFINED ARCHIVE_FILE)
  message(FATAL_ERROR "INPUT_DIR, OUTPUT_FILE and ARCHIVE_FILE are required")
endif()

set(output "/* Generated from public native headers and the built archive; do not edit. */\n")
foreach(name unicode native_abi native_runtime native_strings module_abi native_archive)
  # HEX preserves source bytes and avoids locale/encoding dependencies.
  if(name STREQUAL "native_archive")
    file(READ "${ARCHIVE_FILE}" data HEX)
  else()
    file(READ "${INPUT_DIR}/${name}.h" data HEX)
  endif()
  string(APPEND output "static const unsigned char ${name}_data[] = {\n")
  string(LENGTH "${data}" length)
  set(offset 0)
  while(offset LESS length)
    math(EXPR count "${length} - ${offset}")
    if(count GREATER 32)
      set(count 32)
    endif()
    string(SUBSTRING "${data}" ${offset} ${count} row)
    string(REGEX REPLACE "(..)" "0x\\1, " row "${row}")
    string(APPEND output "    ${row}\n")
    math(EXPR offset "${offset} + ${count}")
  endwhile()
  string(APPEND output "};\n")
endforeach()

# Embed the exact same runtime sources so cross builds compile every instruction with
# the selected target flags, rather than linking a host-specific prebuilt archive.
foreach(pair "runtime_strings;src/native/strings.c" "runtime_str;src/native/str.c" "runtime_number_format;lib/numbers/number_format.c" "runtime_unicode;lib/strings/unicode.c" "number_format_header;lib/numbers/number_format.h" "unicode_table;lib/strings/unicode_data.h")
  list(GET pair 0 name)
  list(GET pair 1 relative)
  file(READ "${INPUT_DIR}/../../${relative}" contents)
  string(REPLACE "\"goat/" "\"" contents "${contents}")
  string(REPLACE "\"lib/numbers/number_format.h\"" "\"number_format.h\"" contents "${contents}")
  string(REPLACE "\"lib/strings/unicode_data.h\"" "\"unicode_data.h\"" contents "${contents}")
  file(WRITE "${OUTPUT_FILE}.${name}.source" "${contents}")
  file(READ "${OUTPUT_FILE}.${name}.source" data HEX)
  file(REMOVE "${OUTPUT_FILE}.${name}.source")
  string(APPEND output "static const unsigned char ${name}_data[] = {\n")
  string(LENGTH "${data}" length)
  set(offset 0)
  while(offset LESS length)
    math(EXPR count "${length} - ${offset}")
    if(count GREATER 32)
      set(count 32)
    endif()
    string(SUBSTRING "${data}" ${offset} ${count} row)
    string(REGEX REPLACE "(..)" "0x\\1, " row "${row}")
    string(APPEND output "    ${row}\n")
    math(EXPR offset "${offset} + ${count}")
  endwhile()
  string(APPEND output "};\n")
endforeach()

get_filename_component(output_dir "${OUTPUT_FILE}" DIRECTORY)
file(MAKE_DIRECTORY "${output_dir}")
file(WRITE "${OUTPUT_FILE}" "${output}")
