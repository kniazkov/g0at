# Lightweight documentation validation; run from the repository root.
@INCLUDE = src/Doxyfile
INPUT = lib src include tools test/src test/support docs/internals
EXCLUDE_PATTERNS = */unicode_data.h */module_json_schema.h */README.md */frozen_samples.md
EXCLUDE = tools/unicode/README.md tools/module-schema/README.md test/support/README.md test/support/frozen_samples.md
FILE_PATTERNS = *.c *.h *.md
EXAMPLE_PATH = test/data/analysis
EXAMPLE_PATTERNS = *.goat *.expect
FILTER_PATTERNS = "*.md=bash scripts/doxygen_markdown.sh"
OUTPUT_DIRECTORY = build/doxygen-check
EXTRACT_ALL = YES
EXTRACT_STATIC = YES
QUIET = YES
WARNINGS = YES
WARN_IF_DOC_ERROR = YES
# Do not require comments, parameter descriptions, or return descriptions.
WARN_IF_UNDOCUMENTED = NO
WARN_IF_INCOMPLETE_DOC = NO
WARN_NO_PARAMDOC = NO
WARN_AS_ERROR = FAIL_ON_WARNINGS
GENERATE_HTML = YES
GENERATE_LATEX = NO
HAVE_DOT = NO
