cmake_minimum_required(VERSION 3.19)
if(NOT DEFINED BUILD_DIR)
  message(FATAL_ERROR "Pass -DBUILD_DIR=<configured build directory>")
endif()
get_filename_component(BUILD_DIR "${BUILD_DIR}" ABSOLUTE)
find_program(CTEST_EXECUTABLE ctest REQUIRED)
execute_process(COMMAND "${CTEST_EXECUTABLE}" --test-dir "${BUILD_DIR}" -L "^gc-acceptance$" --show-only=json-v1
  OUTPUT_VARIABLE inventory RESULT_VARIABLE result TIMEOUT 30)
if(NOT result STREQUAL "0")
  message(FATAL_ERROR "Cannot read CTest inventory: ${result}")
endif()
file(STRINGS "${CMAKE_CURRENT_LIST_DIR}/gc-acceptance-tests.txt" required)
string(JSON count LENGTH "${inventory}" tests)
math(EXPR last "${count} - 1")
set(selected 0)
set(stress_count 0)
foreach(i RANGE 0 ${last})
  string(JSON name GET "${inventory}" tests ${i} name)
  string(JSON properties GET "${inventory}" tests ${i} properties)
  string(JSON property_count LENGTH "${properties}")
  math(EXPR property_last "${property_count} - 1")
  set(labels "")
  set(timeout 0)
  foreach(j RANGE 0 ${property_last})
    string(JSON key GET "${properties}" ${j} name)
    if(key STREQUAL "LABELS")
      string(JSON values GET "${properties}" ${j} value)
      string(JSON size LENGTH "${values}")
      math(EXPR end "${size} - 1")
      foreach(k RANGE 0 ${end})
        string(JSON label GET "${values}" ${k})
        list(APPEND labels "${label}")
      endforeach()
    elseif(key STREQUAL "TIMEOUT")
      string(JSON timeout GET "${properties}" ${j} value)
    endif()
  endforeach()
  if("gc-acceptance" IN_LIST labels)
    math(EXPR selected "${selected} + 1")
    if(timeout LESS_EQUAL 0 OR timeout GREATER 180)
      message(FATAL_ERROR "${name}: missing or excessive timeout (${timeout})")
    endif()
    if("gc-stress" IN_LIST labels)
      math(EXPR stress_count "${stress_count} + 1")
      if("gc-regression" IN_LIST labels)
        message(FATAL_ERROR "${name}: overlapping acceptance groups")
      endif()
    elseif(NOT "gc-regression" IN_LIST labels)
      message(FATAL_ERROR "${name}: missing acceptance group")
    endif()
    list(REMOVE_ITEM required "${name}")
  endif()
endforeach()
if(required OR stress_count LESS 3)
  message(FATAL_ERROR "Incomplete GC acceptance: missing=[${required}], stress=${stress_count}")
endif()
message(STATUS "Verified ${selected} acceptance tests, including ${stress_count} stress tests")
# Preserve successful stress measurements too; any failure stops acceptance.
foreach(group gc-regression gc-stress)
  if(group STREQUAL "gc-stress")
    set(budget 600)
    set(verbosity --verbose)
  else()
    set(budget 900)
    set(verbosity --output-on-failure)
  endif()
  execute_process(COMMAND "${CTEST_EXECUTABLE}" --test-dir "${BUILD_DIR}"
    -L "^${group}$" --no-tests=error ${verbosity}
    --output-log "${BUILD_DIR}/${group}.log"
    RESULT_VARIABLE result TIMEOUT ${budget})
  if(NOT result STREQUAL "0")
    message(FATAL_ERROR "${group} failed or exceeded ${budget}s: ${result}")
  endif()
endforeach()
