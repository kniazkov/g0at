cmake_minimum_required(VERSION 3.13)
if(NOT DEFINED BUILD_DIR OR NOT DEFINED OUTPUT_DIR)
  message(FATAL_ERROR "BUILD_DIR and OUTPUT_DIR are required")
endif()
get_filename_component(BUILD_DIR "${BUILD_DIR}" ABSOLUTE)
get_filename_component(OUTPUT_DIR "${OUTPUT_DIR}" ABSOLUTE)
file(MAKE_DIRECTORY "${OUTPUT_DIR}")
include("${CMAKE_CURRENT_LIST_DIR}/build_command.cmake")
get_filename_component(cmake_bin "${CMAKE_COMMAND}" DIRECTORY)
find_program(package_tool NAMES cpack HINTS "${cmake_bin}" NO_DEFAULT_PATH)
if(NOT package_tool)
  message(FATAL_ERROR "CPack not found beside CMake")
endif()
file(WRITE "${OUTPUT_DIR}/results.tsv" "iteration\tphase\tstart_utc\tseconds\tresult\n")
foreach(iteration RANGE 1 10)
  foreach(phase preinstall cpack)
    if(phase STREQUAL "preinstall")
      goat_build_command(command "${BUILD_DIR}" --target preinstall --config Release)
    else()
      set(command "${package_tool}" --config CPackConfig.cmake -C Release)
    endif()
    string(TIMESTAMP started "%Y-%m-%dT%H:%M:%SZ" UTC)
    string(TIMESTAMP before "%s" UTC)
    set(log "${OUTPUT_DIR}/${iteration}-${phase}.log")
    # Write the pending record before launch so an interrupted run is visible.
    file(APPEND "${OUTPUT_DIR}/events.txt" "${started} START ${iteration} ${phase}: ${command}\n")
    execute_process(COMMAND ${command} WORKING_DIRECTORY "${BUILD_DIR}"
      RESULT_VARIABLE result OUTPUT_FILE "${log}" ERROR_FILE "${log}" TIMEOUT 120)
    string(TIMESTAMP after "%s" UTC)
    math(EXPR elapsed "${after} - ${before}")
    file(APPEND "${OUTPUT_DIR}/results.tsv" "${iteration}\t${phase}\t${started}\t${elapsed}\t${result}\n")
    message(STATUS "Package repetition ${iteration}/10 ${phase}: ${result}, ${elapsed}s")
    if(NOT result STREQUAL "0")
      message(FATAL_ERROR "Repetition ${iteration} ${phase} failed (${result}); see ${log}. No retry.")
    endif()
  endforeach()
endforeach()
