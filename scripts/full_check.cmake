# Shared orchestration for build.sh/build_mingw.cmd --full-check.
cmake_minimum_required(VERSION 3.21)
if(NOT GOAT_FULL_JOBS MATCHES "^[1-9][0-9]*$")
  message(FATAL_ERROR "GOAT_FULL_JOBS must be a positive integer")
endif()
get_filename_component(root "${CMAKE_CURRENT_LIST_DIR}/.." ABSOLUTE)
get_filename_component(cmake_bin "${CMAKE_COMMAND}" DIRECTORY)
find_program(ctest NAMES ctest HINTS "${cmake_bin}" REQUIRED)
find_program(bash NAMES bash REQUIRED)
set(compiler "$ENV{CC}")
if(compiler STREQUAL "")
  set(compiler gcc)
endif()
find_program(compiler_path NAMES "${compiler}" REQUIRED)
set(ENV{CC} "${compiler_path}")
get_filename_component(compiler_name "${compiler_path}" NAME_WE)
set(generator)
if(CMAKE_HOST_WIN32)
  set(generator -G "MinGW Makefiles")
  # Delivery tests intentionally exercise both Windows runtime families.
  foreach(profile MINGW64 UCRT64)
    if("$ENV{GOAT_DELIVERY_${profile}_CC}" STREQUAL "")
      string(TOLOWER "${profile}" prefix)
      execute_process(COMMAND "${bash}" -c "test -x /${prefix}/bin/gcc.exe && cygpath -m /${prefix}/bin/gcc.exe"
        RESULT_VARIABLE found OUTPUT_VARIABLE path OUTPUT_STRIP_TRAILING_WHITESPACE)
      if(NOT found STREQUAL "0" OR NOT EXISTS "${path}")
        message(FATAL_ERROR "Install MSYS2 MINGW64 and UCRT64 GCC, or set GOAT_DELIVERY_${profile}_CC to its absolute executable path")
      endif()
      set(ENV{GOAT_DELIVERY_${profile}_CC} "${path}")
    elseif(NOT EXISTS "$ENV{GOAT_DELIVERY_${profile}_CC}")
      message(FATAL_ERROR "GOAT_DELIVERY_${profile}_CC does not exist")
    endif()
  endforeach()
endif()
set(work "$ENV{FULL_CHECK_DIR}")
if(work STREQUAL "")
  set(work "${root}/build/full-check-${CMAKE_HOST_SYSTEM_NAME}-${compiler_name}")
  if(CMAKE_HOST_WIN32 AND NOT "$ENV{MSYSTEM}" STREQUAL "")
    string(APPEND work "-$ENV{MSYSTEM}")
  endif()
endif()
get_filename_component(work "${work}" ABSOLUTE BASE_DIR "${root}")
file(MAKE_DIRECTORY "${work}")
set(summary "${work}/summary.txt")
file(WRITE "${summary}" "Local full check: ${CMAKE_HOST_SYSTEM_NAME}, ${compiler_path}, ${GOAT_FULL_JOBS} workers\n")
message(STATUS "Full check: ${work}; summary: ${summary}")
message(STATUS "Scope: current host/compiler, Debug + Release; no other architectures or Docker libc jobs")
set_property(GLOBAL PROPERTY full_failures "")
function(step name)
  message(STATUS "=== ${name} ===")
  execute_process(COMMAND ${ARGN} WORKING_DIRECTORY "${root}" RESULT_VARIABLE result)
  if(result STREQUAL "0")
    file(APPEND "${summary}" "PASS ${name}\n")
    set(ok TRUE PARENT_SCOPE)
  else()
    file(APPEND "${summary}" "FAIL ${name}: ${result}\n")
    set_property(GLOBAL APPEND PROPERTY full_failures "${name}")
    set(ok FALSE PARENT_SCOPE)
  endif()
endfunction()
function(configure name source directory configuration)
  step("${name}" "${CMAKE_COMMAND}" -S "${source}" -B "${directory}" ${generator}
    "-DCMAKE_C_COMPILER=${compiler_path}" "-DCMAKE_BUILD_TYPE=${configuration}"
    -DBUILD_TESTING=ON ${ARGN})
  set(ok "${ok}" PARENT_SCOPE)
endfunction()
function(build name directory)
  step("${name}" "${CMAKE_COMMAND}" --build "${directory}" --parallel "${GOAT_FULL_JOBS}" ${ARGN})
  set(ok "${ok}" PARENT_SCOPE)
endfunction()
function(tests name directory)
  step("${name}" "${ctest}" --test-dir "${directory}" --output-on-failure
    --parallel "${GOAT_FULL_JOBS}" --output-log "${directory}/${name}.log" ${ARGN})
endfunction()

# Debug: every registered test except the Release-only package/timing entries.
set(debug "${work}/debug")
configure(debug-configure "${root}" "${debug}" Debug)
set(debug_ready FALSE)
if(ok)
  build(debug-build "${debug}")
  if(ok)
    set(debug_ready TRUE)
    if(NOT CMAKE_HOST_WIN32)
      build(debug-sanitizer-build "${debug}" --target format_binary_ubsan_testing format_oracle_ubsan_testing integer_oracle_ubsan_testing)
    endif()
    tests(debug-tests "${debug}" -E "^package[.]relocated$|^integration[.]native_performance[.]benchmark$")
  endif()
endif()

# Release follows CI's release-safe runners, not assert-based Debug component hosts.
include("${CMAKE_CURRENT_LIST_DIR}/full_check_release.cmake")
set(release "${work}/release")
configure(release-configure "${root}" "${release}" Release)
if(ok)
  build(release-build "${release}")
  if(ok)
    set(package_ready FALSE)
    if(NOT CMAKE_HOST_WIN32)
      build(release-sanitizer-build "${release}" --target format_binary_ubsan_testing format_oracle_ubsan_testing integer_oracle_ubsan_testing)
    endif()
    build(release-package "${release}" --target package --config Release)
    if(ok)
      # CTest enables package.relocated only after archives exist.
      configure(release-package-register "${root}" "${release}" Release)
      if(ok)
        set(package_ready TRUE)
        tests(release-package-test "${release}" -R "^package[.]relocated$")
      endif()
    endif()
    tests(release-tests "${release}" -L "${release_labels}")
    tests(release-format "${release}" -R "^format[.]reference$|^tool[.]frozen-samples")
    tests(release-performance "${release}" -R "^integration[.]native_performance[.]benchmark$")
    if(debug_ready)
      set(exe "")
      if(CMAKE_HOST_WIN32)
        set(exe .exe)
      endif()
      foreach(script native_modes binary_program)
        step("release-${script}" "${bash}" "${root}/scripts/check_${script}.sh"
          "${release}/goat${exe}" "${debug}/functional_testing${exe}" "${release}/check-${script}")
      endforeach()
      if(package_ready)
        step(release-package-debug-host "${debug}/package_scenarios${exe}"
          integration.package.end-to-end "${release}/packages" "${debug}/module_delivery_scenarios${exe}"
          "${compiler_path}" "${root}" "${CMAKE_COMMAND}" --timeout-seconds 1800)
      endif()
    endif()
  endif()
endif()

# Dedicated build configurations from the CI workflow.
foreach(mode Debug Release)
  set(directory "${work}/fault-${mode}")
  configure("fault-${mode}-configure" "${root}" "${directory}" "${mode}" -DGOAT_TEST_ALLOC_FAILURE=ON)
  if(ok)
    build("fault-${mode}-build" "${directory}" --target module_memory_scenarios)
    if(ok)
      tests("fault-${mode}-tests" "${directory}" -L module-memory-migration)
    endif()
  endif()
endforeach()
if(NOT CMAKE_HOST_WIN32)
  set(directory "${work}/stack-pattern")
  configure(stack-pattern-configure "${root}" "${directory}" Debug -DCMAKE_C_FLAGS=-ftrivial-auto-var-init=pattern)
  if(ok)
    build(stack-pattern-build "${directory}" --target module_json_scenarios module_canonical_hash_scenarios)
    if(ok)
      step(stack-pattern-json "${directory}/module_json_testing")
      tests(stack-pattern-tests "${directory}" -R "^native[.]module_(json|canonical|hash)$")
    endif()
  endif()
endif()
foreach(tool unicode module-schema)
  set(directory "${work}/host-${tool}")
  configure("host-${tool}-configure" "${root}/tools/${tool}" "${directory}" Release)
  if(ok)
    build("host-${tool}-build" "${directory}")
    if(ok)
      tests("host-${tool}-tests" "${directory}")
    endif()
  endif()
endforeach()
file(APPEND "${summary}" "NOT COVERED: other compilers/architectures, controlled Docker glibc-floor/musl pairs, GitHub artifact uploads.\nOptional tools (clang-format-18, Doxygen, Graphviz) and platform skips are reported by CMake/CTest; see debug-tests.log.\n")
get_property(failures GLOBAL PROPERTY full_failures)
file(READ "${summary}" report)
message("${report}")
if(failures)
  message(FATAL_ERROR "Full check failed: ${failures}. See ${summary} and retained scenario workspaces.")
endif()
message(STATUS "Full check passed for the available local checks. Review disabled/skipped tests in the logs.")
