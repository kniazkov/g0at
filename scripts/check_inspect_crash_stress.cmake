cmake_minimum_required(VERSION 3.19)
if(NOT DEFINED BUILD_DIR)
  message(FATAL_ERROR "BUILD_DIR is required")
endif()
get_filename_component(BUILD_DIR "${BUILD_DIR}" ABSOLUTE)
find_program(PROBE_CTEST NAMES ctest REQUIRED)
set(pattern "^integration[.]inspect_probe[.](load-crash|unload-crash|tree-crash|cleanup-timeout-load-crash)$")
execute_process(COMMAND "${PROBE_CTEST}" --test-dir "${BUILD_DIR}" --show-only=json-v1 -R "${pattern}"
  RESULT_VARIABLE listed OUTPUT_VARIABLE registry ERROR_VARIABLE list_error TIMEOUT 30)
file(MAKE_DIRECTORY "${BUILD_DIR}/crash-diagnostics")
file(WRITE "${BUILD_DIR}/crash-diagnostics/selected-tests.json" "${registry}")
if(NOT "${listed}" STREQUAL "0")
  message(FATAL_ERROR "Cannot list crash cases: ${listed}: ${list_error}")
endif()
string(JSON count LENGTH "${registry}" tests)
if(NOT count EQUAL 4)
  message(FATAL_ERROR "Expected exactly four crash cases, found ${count}")
endif()
set(expected load-crash unload-crash tree-crash cleanup-timeout-load-crash)
foreach(index RANGE 0 3)
  string(JSON name GET "${registry}" tests ${index} name)
  string(REPLACE "integration.inspect_probe." "" short "${name}")
  if(NOT short IN_LIST expected)
    message(FATAL_ERROR "Unexpected/duplicate crash case: ${name}")
  endif()
  list(REMOVE_ITEM expected "${short}")
endforeach()
if(expected)
  message(FATAL_ERROR "Missing crash cases: ${expected}")
endif()
execute_process(COMMAND "${PROBE_CTEST}" --test-dir "${BUILD_DIR}" --output-on-failure
  --parallel 4 --repeat until-fail:40 --output-log "${BUILD_DIR}/crash-diagnostics/stress.log"
  -R "${pattern}" RESULT_VARIABLE result TIMEOUT 1200)
file(WRITE "${BUILD_DIR}/crash-diagnostics/result.txt" "ctest_result=${result}\n")
if(NOT "${result}" STREQUAL "0")
  message(FATAL_ERROR "Crash stress failed: ${result}; see crash-diagnostics/stress.log")
endif()
