cmake_minimum_required(VERSION 3.13)
get_filename_component(root "${CMAKE_CURRENT_LIST_DIR}/.." ABSOLUTE)
if(NOT DEFINED GOAT_BUILD_DIR OR GOAT_BUILD_DIR STREQUAL "")
  message(FATAL_ERROR "GOAT_BUILD_DIR must name the completed build directory")
endif()
get_filename_component(source "${GOAT_BUILD_DIR}" ABSOLUTE BASE_DIR "${root}")
set(destination "${root}/target")
set(suffix "")
if(CMAKE_HOST_WIN32)
  set(suffix .exe)
endif()
# Check the complete set before replacing any previously published tool.
foreach(tool goat goat-inspect goat-merge)
  if(NOT EXISTS "${source}/${tool}${suffix}" OR IS_DIRECTORY "${source}/${tool}${suffix}")
    message(FATAL_ERROR "Cannot publish missing executable: ${source}/${tool}${suffix}")
  endif()
endforeach()
file(MAKE_DIRECTORY "${destination}")
foreach(tool goat goat-inspect goat-merge)
  set(output "${destination}/${tool}${suffix}")
  if(IS_DIRECTORY "${output}")
    message(FATAL_ERROR "Executable destination is a directory: ${output}")
  endif()
  execute_process(COMMAND "${CMAKE_COMMAND}" -E copy "${source}/${tool}${suffix}" "${output}"
    RESULT_VARIABLE result)
  if(NOT result STREQUAL "0")
    message(FATAL_ERROR "Cannot publish ${output}: ${result}")
  endif()
endforeach()
message(STATUS "Published goat, goat-inspect and goat-merge to ${destination}")
